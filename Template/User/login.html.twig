{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block content %}
<main>

    <div class="container mt-3 mb-3 pt-2 pb-2 bg-white shadow-sm">
        <a href="/index.php" class="pe-3 text-black own-link-hover text-decoration-none border-1 border-end border-black">
            <svg width="20" height="20" fill="currentColor" class="bi bi-house-fill" viewBox="0 0 16 16">
                <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/>
                <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"/>
            </svg>
        </a>
        <span class="ps-3 pe-3 text-black own-link-hover border-1 border-end border-black">
            User
        </span>
        <a href="/index.php/{{ locale }}/user/login" class="ps-3 pe-3 text-black text-decoration-none own-link-hover">
            Login
        </a>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-5 ps-0 pe-2">
                <div class="card bg-white rounded-0 border-0 shadow-sm">
                    <div class="card-body">
                        <p class="card-title fs-5 text-uppercase fw-bold mb-3 pt-1 pb-3 border-bottom">new customer</p>
                        <p class="card-subtitle fw-bold fs-7 mb-1">Register</p>
                        <p class="card-text fs-7 mb-1">
                            By creating an account you will be able to shop faster, be up to date on an order's status, and keep track of the orders you have previously made.
                        </p>
                        <a class="col btn bg-info rounded-0 p-2 own-btn-hover fs-6"
                           href="/index.php/{{ locale }}/user/signIn/">
                            Continue
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-5 ps-1 pe-1">
                <div class="card bg-white rounded-0 border-0 shadow-sm">
                    <div class="card-body">
                        <p class="card-title fs-5 text-uppercase fw-bold mb-3 pt-1 pb-3 border-bottom">returning customer</p>
                        <p class="card-subtitle fw-bold fs-7 mb-1">I am a returning customer</p>
                        <form action="/index.php/{{ locale }}/user/checkLogin" method="POST">
                            <div class="mt-2 mb-2">
                                <label for="username" class="">Username</label>
                                <input
                                    required
                                    type="text"
                                    name="username"
                                    minlength="3"
                                    maxlength="20"
                                    autocomplete="off"
                                    placeholder="Username"
                                    aria-label="username"
                                    class="form-control bg-white text-black fs-7 rounded-0"
                                >
                            </div>
                            <div class="mt-2 mb-2">
                                <label for="password" class="fs-6 mb-1">Password</label>
                                <input
                                    required
                                    type="password"
                                    name="password"
                                    minlength="3"
                                    maxlength="20"
                                    placeholder="Password"
                                    aria-label="password"
                                    class="form-control bg-white text-black fs-7 rounded-0 mb-2"
                                >
                            </div>

                            <div>
                                <a href="/index.php/{{ locale }}/user/forgottenPassword/" class="text-end d-block text-black own-link-hover text-decoration-none">Forgotten Password</a>
                            </div>

                            <button name="submit" type="submit" class="col btn bg-info rounded-0 p-2 own-btn-hover fs-6">
                                Login
                            </button>
                        </form>

                    </div>
                </div>
            </div>
            <div class="col-2 ps-2 pe-0">
                {% include 'link_list.html.twig' %}
            </div>
        </div>
    </div>
</main>
{% endblock %}