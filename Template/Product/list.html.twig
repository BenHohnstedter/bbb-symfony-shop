{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block content %}
    <main>
        <div class="container mt-3">
            <div class="row">
                {% include 'Product/filter.html.twig' %}
                <div class="col-12 col-lg-9">
                    <ul class="row p-0">
                        {% for product in products %}
                        <li class="col-12 col-md-6 col-lg-4 col-xl-3 p-2 list-unstyled">
                            <article class="h-100">
                                <a href="{{ baseUrl }}/index.php/{{ locale }}/product/detail/{{ product.getId() }}" class="card h-100 text-decoration-none d-flex rounded-0 border-0 bg-white shadow-sm resize-item-scale">
                                    <div class="order-2 card-body p-3">
                                        <div class="d-flex flex-column pb-3">
                                            <h3 class="order-2 card-title fs-6 opacity-75 my-2 h-100">{{ product.getName() }}</h3>
                                            <p class="order-3 card-text text-start m-0 position-absolute bottom-0 pb-2">{{ product.getPrice() | number_format(2, '.', ',') }}€</p>

                                            <div class="order-1 pb-2 text-info border-1 border-bottom" title="{{ product.getStarAverage() }} Sternebewertung">
                                                {% set stars = product.getStarAverage() %}
                                                {% include 'stars.html.twig' %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="order-1 image-size overflow-hidden d-flex justify-content-center bg-white rounded-3 p-4">
                                        <img src="{{ baseUrl }}/Resource/Img/ProductImg/{{ product.getImagePath() }}"
                                             alt="{{ product.getName() }}" class="img-fluid object-fit-scale rounded-1">
                                    </div>
                                </a>
                            </article>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </main>
{% endblock %}