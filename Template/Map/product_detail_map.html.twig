<div class="modal fade" id="mapModal" tabindex="-1" aria-labelledby="mapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered own-map-modal-size">
        <div class="modal-content">
            <div id="map" class="rounded-3 modal-map"></div>
        </div>
    </div>
</div>

<script>
    document.getElementById('mapModal').addEventListener('shown.bs.modal', function(){
        var map = L.map('map').setView(['{{ product.getUserObject().getLat() }}', '{{ product.getUserObject().getLon() }}'], 7);

        L.tileLayer('https://tile.openstreetmap.de/{z}/{x}/{y}.png', {
            maxZoom: 20,
            minZoom: 3,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        {% if principal.isBuyer() %}

            var user = L.icon({
                iconUrl: '/Resource/Bootstrap-icons-1.11.1/house-fill.svg',

                iconSize:     [35, 35], // size of the icon
                popupAnchor:  [1, -20] // point from which the popup should open relative to the iconAnchor
            });

            var markerUser = L.marker(['{{ principal.getLat() }}', '{{ principal.getLon() }}'], {icon: user}).addTo(map);
            markerUser.bindPopup("Du - {{ principal.getUsername() }}: {{ principal.getStreet() }} {{ principal.getHouseNumber() }} - {{ principal.getCity() }}, {{ principal.getPostalCode() }}").openPopup();
        {% endif %}

        var seller = L.icon({
            iconUrl: '/Resource/Bootstrap-icons-1.11.1/basket3-fill.svg',

            iconSize:     [35, 35], // size of the icon
            popupAnchor:  [1, -20] // point from which the popup should open relative to the iconAnchor
        });

        var markerSeller = L.marker(['{{ product.getUserObject().getLat() }}', '{{ product.getUserObject().getLon() }}'], {icon: seller}).addTo(map);
        markerSeller.bindPopup("Verkäufer - {{ product.getUserObject().getUsername() }}: {{ product.getUserObject().getStreet() }} {{ product.getUserObject().getHouseNumber() }} - {{ product.getUserObject().getCity() }}, {{ product.getUserObject().getPostalCode() }}").openPopup();
    });
</script>