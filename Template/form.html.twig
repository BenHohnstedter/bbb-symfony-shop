{% extends 'bootstrap_5_horizontal_layout.html.twig' %}

{% block form %}
{{ form_start(form) }}
<div class="container pt-2 pb-2">
    <div class="row">
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.name) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.imagePath) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.imagePath, {'attr': {'class': 'custom-file-upload'}}) }}
            {{ form_errors(form.imagePath) }}
        </div>
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.price) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.price) }}
            {{ form_errors(form.price) }}
        </div>
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.category) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.category) }}
            {{ form_errors(form.category) }}
        </div>
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.amount) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.amount) }}
            {{ form_errors(form.amount) }}
        </div>
        <div class="col-3 py-2 d-flex justify-content-end">
            <span class="text-danger pt-1 pe-1">*</span>
            {{ form_label(form.description) }}
        </div>
        <div class="col-9 pe-0 py-2">
            {{ form_widget(form.description) }}
            {{ form_errors(form.description, {'attr': {'id': 'test'}}) }}
        </div>
        <div class="d-flex justify-content-end p-0">
            {{ form_widget(form.save, {'attr': {'class': 'border-0 bg-info rounded-0 p-2 mt-2 ms-2 own-btn-hover fs-6'}}) }}
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}