<div class="col-12">
    <ul class="p-0">
        {% set counter = 0 %}
        {% for review in product.getReviews() %}
        {% set counter = counter + 1  %}
        <li class="card rounded-0 bg-white mb-4 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-self-center text-info pb-2 border-bottom">
                    {% set stars = review.getStars() %}
                    {% include 'stars.html.twig' %}

                    <p class="d-inline fs-7 m-0 h-100 align-middle ps-1">- {{ review.getCreatedAt() }}</p>
                </div>
                <div class="pt-2 pb-2 border-bottom d-flex align-items-center">
                    <img src="/Resource/Img/UserImg/{{ review.getUserObject().getProfileImg() }}" alt="{{ review.getUserObject().getUsername() }}" class="icon-size rounded-circle">
                    <p class="ps-2 m-0 fs-6"> {{ review.getUserObject().getUsername() }}</p>
                </div>
                <p class="card-title fs-5 m-0 pt-1">{{ review.getTitle() }}</p>
                <p class="card-text mt-1 pe-6">{{ review.getComment() }}</p>
            </div>
        </li>
        {% endfor %}

        {% if counter == 0 %}
        <li class="fs-6">Es wurden noch keine Rezensionen verfasst.</li>
        {% endif %}
    </ul>
</div>